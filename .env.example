# MySQL connection (create the database first: CREATE DATABASE hraction CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DATABASE_URL="mysql://root:password@localhost:3306/hraction"

# Session encryption key — at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD="change-me-to-a-long-random-string-of-32-plus-chars"

# Where profile photos are saved
NUXT_UPLOAD_DIR="./uploads"

# Production only: first admin account created by `npm run build:hostinger`
# (role IT, password = this phone number, must be changed at first login)
ADMIN_PHONE="07XXXXXXXX"
ADMIN_NAME="IT Admin"
